{
  "name": "@wriven-ai/next",
  "version": "0.2.1",
  "description": "Next.js helpers for Wriven: a signed webhook \u2192 revalidate route handler and preview/draft wiring.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "@wriven/wriven": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "check": "publint && attw --pack .",
    "prepublishOnly": "pnpm build && pnpm check",
    "test": "tsx --test test/*.test.ts"
  },
  "keywords": [
    "wriven",
    "cms",
    "headless",
    "next",
    "nextjs",
    "webhook",
    "isr",
    "revalidate"
  ],
  "peerDependencies": {
    "next": ">=14"
  },
  "devDependencies": {
    "@types/node": "^20"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://wriven.tech",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wriven-ai/wriven.git",
    "directory": "packages/next"
  },
  "bugs": {
    "url": "https://github.com/wriven-ai/wriven/issues"
  }
}
