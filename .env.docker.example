# ── Database (Postgres) ────────────────────────────────────────────────────
# For local dev, use the compose postgres: postgresql://wriven:wriven_dev_password_change_me@postgres:5432/wriven
# For production, use Supabase pooled connection strings
DATABASE_URL="postgresql://wriven:wriven_dev_password_change_me@postgres:5432/wriven"
DIRECT_URL="postgresql://wriven:wriven_dev_password_change_me@postgres:5432/wriven"

# ── JWT (tenant auth) ─────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET="change-me-generate-with-openssl-rand-base64-32"
REFRESH_SECRET="change-me-generate-with-openssl-rand-base64-32"

# ── Admin JWT (separate from tenant JWT) ────────────────────────────────────
ADMIN_JWT_SECRET="change-me-generate-with-openssl-rand-base64-32-different-from-above"

# ── Google OAuth (optional) ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Mail / SMTP ────────────────────────────────────────────────────────────────
MAIL_HOST="smtp.gmail.com"
MAIL_PORT="587"
MAIL_USER="your-email@gmail.com"
MAIL_PASS="your-app-password"
MAIL_FROM="noreply@wriven.io"

# ── R2 Storage (Cloudflare) ────────────────────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="wriven-dev"
R2_ENDPOINT=""
R2_PUBLIC_URL="https://your-dev-bucket.r2.dev"

# ── Frontend URL ────────────────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:5000/api/v1"
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# ── AI Service (optional) ───────────────────────────────────────────────────────
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
