# Wriven Docker Commands
# =========================

.PHONY: help build up down restart logs ps prune build-auth build-core build-gateway build-client build-ai

help: ## Show this help message
	@echo 'Usage: make [target]'
	@echo ''
	@echo 'Available targets:'
	@awk 'BEGIN {FS = ":.*?## "} /^[a-zA-Z_-]+:.*?## / { printf "  %-15s %s\n", $$1, $$2 }' $(MAKEFILE_LIST)

# ── Build ────────────────────────────────────────────────────────────────────────

build: ## Build all services
	docker-compose build

build-auth: ## Build auth-service only
	docker-compose build auth-service

build-core: ## Build core-service only
	docker-compose build core-service

build-gateway: ## Build api-gateway only
	docker-compose build api-gateway

build-client: ## Build client only
	docker-compose build client

build-ai: ## Build ai-service only
	docker-compose --profile ai build ai-service

# ── Run ───────────────────────────────────────────────────────────────────────────

up: ## Start all services (foreground)
	docker-compose up

up-d: ## Start all services (detached)
	docker-compose up -d

up-prod: ## Start production stack
	docker-compose -f docker-compose.prod.yml up -d

up-dev: ## Start dev stack with logs
	docker-compose up --remove-orphans

down: ## Stop all services
	docker-compose down

restart: ## Restart all services
	docker-compose restart

# ── Logs & Debug ─────────────────────────────────────────────────────────────────

logs: ## Show logs from all services
	docker-compose logs -f

logs-auth: ## Show auth-service logs
	docker-compose logs -f auth-service

logs-core: ## Show core-service logs
	docker-compose logs -f core-service

logs-gateway: ## Show api-gateway logs
	docker-compose logs -f api-gateway

logs-client: ## Show client logs
	docker-compose logs -f client

ps: ## Show running containers
	docker-compose ps

# ── Maintenance ───────────────────────────────────────────────────────────────────

prune: ## Remove unused Docker resources
	docker system prune -a -f --volumes

clean: ## Remove all containers, networks, and volumes
	docker-compose down -v
	docker system prune -f

rebuild: ## Rebuild and restart all services
	docker-compose down
	docker-compose build --no-cache
	docker-compose up -d

# ── Database ───────────────────────────────────────────────────────────────────────

db-migrate: ## Run database migrations (core-service)
	docker-compose exec core-service pnpm db:core:migrate

db-studio: ## Open Drizzle Studio
	docker-compose exec core-service pnpm db:core:studio

# ── Production Build Tags ───────────────────────────────────────────────────────────

tag-all: ## Tag all images for production
	docker tag wriven-auth-service:latest wriven/auth-service:${TAG}
	docker tag wriven-core-service:latest wriven/core-service:${TAG}
	docker tag wriven-api-gateway:latest wriven/api-gateway:${TAG}
	docker tag wriven-client:latest wriven/client:${TAG}

push-all: tag-all ## Push all tagged images to registry
	docker push wriven/auth-service:${TAG}
	docker push wriven/core-service:${TAG}
	docker push wriven/api-gateway:${TAG}
	docker push wriven/client:${TAG}

# ── Health Checks ───────────────────────────────────────────────────────────────────

health: ## Check health of all services
	@echo "Checking API Gateway..."
	@curl -sf http://localhost:5000/api/v1/health || echo "API Gateway: DOWN"
	@echo "Checking Auth Service..."
	@curl -sf http://localhost:5001/health || echo "Auth Service: DOWN"
	@echo "Checking Core Service..."
	@curl -sf http://localhost:5002/health || echo "Core Service: DOWN"
	@echo "Checking Client..."
	@curl -sf http://localhost:3000 || echo "Client: DOWN"
