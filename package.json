{
  "name": "@wriven/wriven",
  "version": "0.0.1",
  "license": "MIT",
  "scripts": {
    "dev:auth": "pnpm nx serve auth-service",
    "dev:core": "pnpm nx serve core-service",
    "dev:gateway": "pnpm nx serve api-gateway",
    "dev:ai": "pnpm nx serve @wriven/ai-service",
    "dev:client": "pnpm nx dev client",
    "dev:all": "pnpm nx run-many -t serve dev --parallel",
    "build": "pnpm nx run-many -t build",
    "build:affected": "pnpm nx affected -t build",
    "test": "pnpm nx run-many -t test",
    "test:affected": "pnpm nx affected -t test",
    "lint": "pnpm nx run-many -t lint",
    "lint:affected": "pnpm nx affected -t lint",
    "graph": "pnpm nx graph",
    "db:auth:generate": "drizzle-kit generate --config apps/auth-service/drizzle.config.ts",
    "db:auth:migrate": "drizzle-kit migrate --config apps/auth-service/drizzle.config.ts",
    "db:auth:push": "drizzle-kit push --config apps/auth-service/drizzle.config.ts",
    "db:auth:studio": "drizzle-kit studio --config apps/auth-service/drizzle.config.ts",
    "db:auth:seed": "tsx --env-file=apps/auth-service/.env apps/auth-service/src/db/seed.ts",
    "billing:replay": "tsx --tsconfig apps/auth-service/tsconfig.app.json apps/auth-service/src/billing/stripe-event-replay.script.ts",
    "db:core:generate": "drizzle-kit generate --config apps/core-service/drizzle.config.ts",
    "db:core:migrate": "drizzle-kit migrate --config apps/core-service/drizzle.config.ts",
    "db:core:push": "drizzle-kit push --config apps/core-service/drizzle.config.ts",
    "db:core:studio": "drizzle-kit studio --config apps/core-service/drizzle.config.ts",
    "sdk:build": "pnpm -r --filter \"./packages/*\" build",
    "sdk:test": "pnpm -r --filter \"./packages/*\" test",
    "sdk:check": "pnpm -r --filter \"./packages/*\" check",
    "sdk:publish": "pnpm -r --filter \"./packages/*\" publish --access public"
  },
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.4",
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.2.1",
    "@next/eslint-plugin-next": "^16.3.1",
    "@nx/eslint": "22.7.5",
    "@nx/eslint-plugin": "22.7.5",
    "@nx/jest": "22.7.5",
    "@nx/js": "22.7.5",
    "@nx/nest": "^22.7.5",
    "@nx/next": "^22.7.5",
    "@nx/node": "^22.7.5",
    "@nx/web": "22.7.5",
    "@nx/webpack": "22.7.5",
    "@swc-node/register": "1.12.1",
    "@swc/cli": "~0.8.0",
    "@swc/core": "1.16.0",
    "@swc/helpers": "0.5.23",
    "@swc/jest": "~0.2.38",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/jest": "~30.0.0",
    "@types/node": "20.19.9",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "10.5.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.8.0",
    "eslint-config-next": "^16.3.1",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.0.0",
    "jest": "~30.4.2",
    "jest-environment-node": "~30.4.1",
    "jest-util": "~30.4.1",
    "nx": "22.7.5",
    "postcss": "8.5.26",
    "prettier": "^3.9.6",
    "publint": "^0.3.23",
    "tailwindcss": "3.4.3",
    "ts-jest": "^29.4.12",
    "ts-node": "10.9.2",
    "tslib": "^2.3.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.67.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.2.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@tanstack/react-query": "^5.101.0",
    "axios": "^1.19.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "next": "~16.3.1",
    "nodemailer": "^9.0.5",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "zustand": "^5.0.15"
  }
}
