# core-service environment
# Copy to .env and fill in real values. Never commit .env.

PORT=5002

# PostgreSQL (Drizzle ORM). Single shared Supabase DB; core-service uses schema "core_svc".
# DATABASE_URL = transaction-mode pooler (6543, IPv4) for app runtime.
# DIRECT_URL   = session-mode pooler (5432, IPv4) for migrations.
# Copy both from Supabase Dashboard > Connect.
DATABASE_URL="postgresql://postgres.<project-ref>:[YOUR-DB-PASSWORD]@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:[YOUR-DB-PASSWORD]@aws-1-<region>.pooler.supabase.com:5432/postgres"

# Cloudflare R2 (store object keys only, never full URLs)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public read base for serving media. R2: enable the bucket's r2.dev subdomain
# (or bind a custom domain). e.g. https://pub-<hash>.r2.dev
R2_PUBLIC_URL=
# Optional: explicit S3 endpoint override (else derived from R2_ACCOUNT_ID).
# For local MinIO during dev: http://localhost:9000
# R2_ENDPOINT=

# CDN cache-tag purge on publish (optional — Cloudflare). Without these,
# purge is a no-op; the Delivery API still sets Cache-Control + cache tags.
CF_ZONE_ID=
CF_API_TOKEN=

# auth-service (internal TCP) — core resolves plan limits from here to enforce
# per-workspace quotas (api keys, webhooks, entries, content types, storage).
AUTH_SERVICE_HOST=auth-service
AUTH_SERVICE_PORT=5001

# ai-service (FastAPI) — called over HTTP
AI_SERVICE_URL=http://ai-service:8000
# Shared secret sent to ai-service; must match ai-service INTERNAL_SECRET
INTERNAL_SECRET=
