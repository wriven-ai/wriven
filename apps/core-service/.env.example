# core-service environment
# Copy to .env and fill in real values. Never commit .env.

PORT=5002

# PostgreSQL (Drizzle ORM). Single shared Supabase DB; core-service uses schema "core_svc".
# DATABASE_URL = transaction-mode pooler (6543, IPv4) for app runtime.
# DIRECT_URL   = session-mode pooler (5432, IPv4) for migrations.
# Copy both from Supabase Dashboard > Connect.
DATABASE_URL="postgresql://postgres.<project-ref>:[YOUR-DB-PASSWORD]@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:[YOUR-DB-PASSWORD]@aws-1-<region>.pooler.supabase.com:5432/postgres"

# Cloudflare R2 (store object keys only, never full URLs)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public read base for serving media. R2: enable the bucket's r2.dev subdomain
# (or bind a custom domain). e.g. https://pub-<hash>.r2.dev
R2_PUBLIC_URL=
# Optional: explicit S3 endpoint override (else derived from R2_ACCOUNT_ID).
# For local MinIO during dev: http://localhost:9000
# R2_ENDPOINT=

# CDN cache-tag purge on publish (optional — Cloudflare). Without these,
# purge is a no-op; the Delivery API still sets Cache-Control + cache tags.
CF_ZONE_ID=
CF_API_TOKEN=

# auth-service (internal TCP) — core resolves plan limits from here to enforce
# per-workspace quotas (api keys, webhooks, entries, content types, storage).
AUTH_SERVICE_HOST=auth-service
AUTH_SERVICE_PORT=5001

# AI content generation — generation runs in the standalone Python ai-service;
# core-service calls it over HTTP. The provider key (AI_API_KEY etc.) lives in
# ai-service env, NOT here. core only needs the service URL + shared secret.
# HTTP deadline for the core → ai-service hop (ms). Keep this slightly longer
# than ai-service's provider AI_TIMEOUT_MS so its timeout response reaches core.
AI_SERVICE_TIMEOUT_MS=35000
AI_SERVICE_URL=http://localhost:8000
# Must match ai-service INTERNAL_SECRET (authenticates the internal HTTP hop).
INTERNAL_SECRET=
# Redact generated output and request hashes from AI audit rows after this many
# days; operational metadata remains for billing and incident investigation.
AI_AUDIT_RETENTION_DAYS=30
# Optional fallback list price for the configured AI model, in micro-USD per
# 1,000,000 tokens (e.g. $0.15 = 150000). This is the LAST-TIER price resolver:
# cost is normally priced from the RETURNED model in apps/core-service/src/ai/
# ai-model-prices.ts (`*:free` → $0, exact-match map, then this pair), so leave
# both empty unless AI_MODEL points at a single known-priced paid model. Unknown
# models stay null (never guessed) and surface as cost.complete=false in /usage.
AI_INPUT_COST_MICROUSD_PER_MILLION_TOKENS=
AI_OUTPUT_COST_MICROUSD_PER_MILLION_TOKENS=
# Hard backstop for the gateway → core → ai-service round trip. Must exceed
# AI_SERVICE_TIMEOUT_MS so core normally wins the race; kills a wedged downstream
# instead of pinning a gateway worker.
AI_GATEWAY_TIMEOUT_MS=40000
