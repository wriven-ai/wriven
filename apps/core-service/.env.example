# core-service environment
# Copy to .env and fill in real values. Never commit .env.

PORT=5002

# PostgreSQL connection string (Drizzle ORM)
# Single shared Supabase DB across all services; core-service uses schema "core_svc"
DATABASE_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres

# Cloudflare R2 (store object keys only, never full URLs)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ai-service (FastAPI) — called over HTTP
AI_SERVICE_URL=http://ai-service:8000
# Shared secret sent to ai-service; must match ai-service INTERNAL_SECRET
INTERNAL_SECRET=
