{
  "name": "@wriven/core-service",
  "version": "0.0.2",
  "private": true,
  "nx": {
    "targets": {
      "test-integration": {
        "executor": "nx:run-commands",
        "options": {
          "command": "jest --config jest.integ.config.cts --runInBand",
          "cwd": "apps/core-service"
        },
        "cache": false,
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/jest.preset.js",
          {
            "externalDependencies": [
              "jest",
              "@nx/jest",
              "reflect-metadata",
              "ts-jest",
              "testcontainers",
              "@testcontainers/postgresql"
            ]
          }
        ]
      },
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "webpack-cli build",
          "args": [
            "--node-env=production"
          ],
          "cwd": "apps/core-service"
        },
        "configurations": {
          "development": {
            "args": [
              "--node-env=development"
            ]
          }
        }
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@wriven/core-service:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@wriven/core-service:build:development"
          },
          "production": {
            "buildTarget": "@wriven/core-service:build:production"
          }
        }
      }
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.0",
    "@nestjs/microservices": "^11.1.26",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@wriven/contracts": "workspace:*",
    "@wriven/database": "workspace:*",
    "axios": "^1.7.0",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0"
  }
}
