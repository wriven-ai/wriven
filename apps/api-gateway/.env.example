# api-gateway environment
# Copy to .env and fill in real values. Never commit .env.

# Public HTTP port (only service exposed to the internet)
PORT=5000

# Frontend origin — Google OAuth callback redirect (not CORS)
CLIENT_ORIGIN=http://localhost:3000

# CORS allowlist (exact origins, credentials enabled — never `*`).
# Comma-separated. Local dev default: http://localhost:3000,http://localhost:3001
# Production: wriven.tech + www + admin.wriven.tech + www.admin.wriven.tech (both domains, with and without www)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# JWT — same value as auth-service (gateway validates tokens locally)
JWT_SECRET=

# Admin panel — separate secret, same value as auth-service ADMIN_JWT_SECRET
# (gateway verifies admin tokens locally). MUST differ from JWT_SECRET.
ADMIN_JWT_SECRET=

# Downstream NestJS services (internal TCP)
AUTH_SERVICE_HOST=auth-service
AUTH_SERVICE_PORT=5001
CORE_SERVICE_HOST=core-service
CORE_SERVICE_PORT=5002

# ai-service is FastAPI — called over HTTP, not TCP
AI_SERVICE_URL=http://ai-service:8000

# Google OAuth (Passport strategy runs on the gateway)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/v1/auth/google/callback

# Usage metering (specs/14). Delivery API request counter — gateway batches
# increments off the hot path and flushes to core-service. USAGE_ENFORCE gates
# the soft overage block (default off: meter+display only until validated).
USAGE_ENFORCE=false
USAGE_FLUSH_INTERVAL_MS=15000
USAGE_FLUSH_THRESHOLD=100
USAGE_ENFORCE_TTL_MS=30000
