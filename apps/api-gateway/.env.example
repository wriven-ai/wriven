# api-gateway environment
# Copy to .env and fill in real values. Never commit .env.

# Public HTTP port (only service exposed to the internet)
PORT=5000

# Frontend origin allowed for CORS (credentials enabled for refresh cookie)
CLIENT_ORIGIN=http://localhost:3000

# JWT — same value as auth-service (gateway validates tokens locally)
JWT_SECRET=

# Downstream NestJS services (internal TCP)
AUTH_SERVICE_HOST=auth-service
AUTH_SERVICE_PORT=5001
CORE_SERVICE_HOST=core-service
CORE_SERVICE_PORT=5002

# ai-service is FastAPI — called over HTTP, not TCP
AI_SERVICE_URL=http://ai-service:8000

# Google OAuth (Passport strategy runs on the gateway)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
