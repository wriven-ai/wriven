{
  "name": "@wriven/ai-service",
  "version": "0.0.2",
  "private": true,
  "nx": {
    "name": "@wriven/ai-service",
    "targets": {
      "serve": {
        "continuous": true,
        "executor": "nx:run-commands",
        "options": {
          "command": "uv run uvicorn main:app --host 0.0.0.0 --port 8000 --reload",
          "cwd": "apps/ai-service"
        }
      },
      "test": {
        "executor": "nx:run-commands",
        "options": {
          "command": "uv run pytest",
          "cwd": "apps/ai-service"
        },
        "cache": false,
        "inputs": [
          "default",
          "{projectRoot}/pyproject.toml",
          "{projectRoot}/uv.lock"
        ]
      }
    }
  }
}
