{
  "name": "@wriven/ai-service",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "@wriven/ai-service",
    "targets": {
      "serve": {
        "continuous": true,
        "executor": "nx:run-commands",
        "options": {
          "command": "uv run uvicorn main:app --host 0.0.0.0 --port 8000 --reload",
          "cwd": "apps/ai-service"
        }
      }
    }
  }
}
