# ai-service environment (FastAPI)
# Copy to .env and fill in real values. Never commit .env.

# Shared secret to authenticate calls from core-service; must match core-service INTERNAL_SECRET
INTERNAL_SECRET=

# Cloudflare R2 (store object keys only, never full URLs)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Model provider
OPENAI_API_KEY=
