# ai-service environment (FastAPI)
# Copy to .env and fill in real values. Never commit .env.

# LLM provider (generic OpenAI-compatible Chat Completions).
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openrouter/free
AI_TIMEOUT_MS=30000
# Hard spend/context guardrails. Individual actions can use lower output caps.
AI_MAX_INPUT_CHARS=24000
AI_MAX_OUTPUT_TOKENS=8000
# Optional JSON of extra provider headers (e.g. OpenRouter attribution).
AI_HEADERS=

# Shared secret authenticating the core-service -> ai-service HTTP hop.
# Must match core-service INTERNAL_SECRET.
INTERNAL_SECRET=

# "production" disables the interactive docs (/docs, /redoc, /openapi.json).
ENVIRONMENT=development

PORT=8000
