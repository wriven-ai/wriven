# api-gateway base URL (must include /api/v1). Exposed to the browser.
NEXT_PUBLIC_API_URL=http://localhost:5000/v1

# Set to true when tunneling the gateway through ngrok (adds skip-browser-warning header).
NEXT_PUBLIC_USE_NGROK=false

# Demo account credentials. When both are set, a "Demo Login" button shows on the
# login page that signs in with them (useful for recruiters/demo access).
# Exposed to the browser — only use a low-privilege test account.
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=
