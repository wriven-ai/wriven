# auth-service environment
# Copy to .env and fill in real values. Never commit .env.

PORT=5001

# PostgreSQL (Drizzle ORM). Single shared Supabase DB; auth-service uses schema "auth_svc".
# DATABASE_URL = transaction-mode pooler (6543, IPv4) for app runtime.
# DIRECT_URL   = session-mode pooler (5432, IPv4) for migrations.
# Copy both from Supabase Dashboard > Connect.
DATABASE_URL="postgresql://postgres.<project-ref>:[YOUR-DB-PASSWORD]@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:[YOUR-DB-PASSWORD]@aws-1-<region>.pooler.supabase.com:5432/postgres"

# JWT — must match api-gateway's JWT_SECRET (gateway validates tokens locally)
JWT_SECRET=
JWT_ACCESS_TTL=15m   # access token TTL (e.g. 15m, 1h)
JWT_REFRESH_TTL=7d   # refresh TTL
JWT_REFRESH_TTL_REMEMBER=30d  # refresh TTL with rememberMe

# Password hashing
BCRYPT_ROUNDS=12
RESET_TOKEN_TTL=1h     # password reset token TTL
EMAIL_VERIFY_TTL=24h  # email verification token TTL

# Note: Google OAuth credentials live on the api-gateway (the Passport strategy
# runs there, since auth-service has no public HTTP endpoint).

# SMTP (password reset + verification emails)
# Gmail example — requires 2-Step Verification + an App Password
# (https://myaccount.google.com/apppasswords). Use the 16-char app password as
# MAIL_PASS, never your account password. ~500 emails/day cap; swap to a
# transactional provider (Resend, SES, Postmark) for production volume.
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USER=you@gmail.com
#   MAIL_PASS=your16charapppassword
#   MAIL_FROM=Wriven <you@gmail.com>
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# Frontend base URL for reset links
APP_URL=http://localhost:4200

# ── Admin panel (platform console) ──────────────────────────────────────────
# Separate signing secret for admin access tokens — MUST differ from JWT_SECRET
# so an admin token can never satisfy the tenant guard (or vice-versa).
ADMIN_JWT_SECRET=
ADMIN_JWT_ACCESS_TTL=15m
ADMIN_REFRESH_TTL=7d
# Bootstrap admin seeded by `pnpm db:auth:seed` (run once after migrate).
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=Platform Admin
