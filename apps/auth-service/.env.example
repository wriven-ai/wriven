# auth-service environment
# Copy to .env and fill in real values. Never commit .env.

PORT=5001

# PostgreSQL (Drizzle ORM). Single shared Supabase DB; auth-service uses schema "auth_svc".
# DATABASE_URL = transaction-mode pooler (6543, IPv4) for app runtime.
# DIRECT_URL   = session-mode pooler (5432, IPv4) for migrations.
# Copy both from Supabase Dashboard > Connect.
DATABASE_URL="postgresql://postgres.<project-ref>:[YOUR-DB-PASSWORD]@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:[YOUR-DB-PASSWORD]@aws-1-<region>.pooler.supabase.com:5432/postgres"

# JWT — must match api-gateway's JWT_SECRET (gateway validates tokens locally)
JWT_SECRET=
JWT_ACCESS_TTL=900                # access token TTL, 15 min (seconds)
JWT_REFRESH_TTL=604800            # refresh TTL, 7 days (seconds)
JWT_REFRESH_TTL_REMEMBER=2592000  # refresh TTL with rememberMe, 30 days (seconds)

# Password hashing
BCRYPT_ROUNDS=12
RESET_TOKEN_TTL=3600              # password reset token TTL, 1 hour (seconds)

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# SMTP (password reset emails)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# Frontend base URL for reset links
APP_URL=http://localhost:4200
